# Server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production (Render): add your Vercel URL, comma-separated
# CORS_ORIGINS=https://mindforge.vercel.app

# Production database (optional; default uses LOCALAPPDATA on Windows)
# DATABASE_URL=sqlite+aiosqlite:///./mindforge.db

# Hybrid RAG — set false on low-memory deploy (Render free tier)
USE_EMBEDDING_RAG=true
