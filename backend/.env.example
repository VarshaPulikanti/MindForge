# Server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production (Render): add your Vercel URL, comma-separated
# CORS_ORIGINS=https://mind-forge-phi.vercel.app

# Database
# Leave empty to use local SQLite (%LOCALAPPDATA%\MindForge\mindforge.db).
# For PostgreSQL (recommended — same URL works locally AND on Render):
#   - Free cloud Postgres: https://neon.tech (no credit card)
#   - Render PostgreSQL (persistent) for production
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Auth — change JWT_SECRET in production
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=72

# Hybrid RAG — set false on low-memory deploy (Render free tier)
USE_EMBEDDING_RAG=true
USE_VECTOR_STORE=true

# LLM for RAG chat (optional — adds real "Generation" after retrieval)
# local  = extractive only (no API key)
# gemini = free Google Gemini API — recommended (https://aistudio.google.com/apikey)
# groq   = Groq API (console.groq.com)
# ollama = local Ollama only — does not work on Render free tier
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Production (Render) — copy into Render Environment ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# USE_EMBEDDING_RAG=false
# USE_VECTOR_STORE=false
# CORS_ORIGINS=https://mind-forge-phi.vercel.app
